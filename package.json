{
	"name": "tablemark-cli",
	"version": "0.0.0-dev",
	"description": "Generate markdown tables from JSON data at the command line.",
	"keywords": [
		"cli",
		"cli-app",
		"markdown",
		"tables",
		"json",
		"convert",
		"generate"
	],
	"homepage": "https://github.com/haltcase/tablemark-cli",
	"bugs": "https://github.com/haltcase/tablemark-cli/issues",
	"repository": "https://github.com/haltcase/tablemark-cli.git",
	"license": "MIT",
	"author": "Bo Lingen <bo@haltcase.dev> (https://github.com/haltcase)",
	"type": "module",
	"exports": "./dist/index.js",
	"bin": {
		"tablemark": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"eslint:check": "eslint src",
		"format": "oxlint --fix && eslint --fix src tests && prettier --write src tests",
		"oxlint:check": "oxlint",
		"prepublishOnly": "vitest --run && pnpm build",
		"prettier:check": "prettier --check src",
		"test": "vitest",
		"typescript:check": "tsgo"
	},
	"prettier": "@haltcase/style/prettier",
	"dependencies": {
		"cmd-ts": "^0.14.1",
		"tablemark": "^4.1.0"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@actions/exec": "^1.1.1",
		"@actions/github": "^6.0.1",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@commitlint/types": "^20.0.0",
		"@haltcase/style": "^7.3.1",
		"@octokit/types": "^14.1.0",
		"@types/node": "^20.19.13",
		"@typescript/native-preview": "7.0.0-dev.20250911.1",
		"conventional-changelog-conventionalcommits": "*",
		"eslint": "^9.35.0",
		"eslint-plugin-oxlint": "^1.15.0",
		"execa": "^9.6.0",
		"lefthook": "^1.13.0",
		"oxlint": "^1.15.0",
		"prettier": "^3.6.2",
		"semantic-release": "^24.2.8",
		"tsdown": "^0.15.0",
		"tsx": "catalog:",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=20"
		}
	}
}
