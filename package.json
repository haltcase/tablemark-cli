{
	"name": "tablemark-cli",
	"version": "0.0.0-dev",
	"description": "Generate markdown tables from JSON data at the command line.",
	"keywords": [
		"cli",
		"cli-app",
		"markdown",
		"tables",
		"json",
		"convert",
		"generate"
	],
	"homepage": "https://github.com/haltcase/tablemark-cli",
	"bugs": "https://github.com/haltcase/tablemark-cli/issues",
	"repository": "https://github.com/haltcase/tablemark-cli.git",
	"license": "MIT",
	"author": "Bo Lingen <bo@haltcase.dev> (https://github.com/haltcase)",
	"type": "module",
	"exports": "./dist/index.js",
	"bin": {
		"tablemark": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"eslint:check": "eslint src",
		"format": "oxlint --fix && eslint --fix src tests && prettier --write src tests",
		"oxlint:check": "oxlint",
		"prepublishOnly": "pnpm format && pnpm build",
		"prettier:check": "prettier --check src",
		"test": "vitest",
		"typescript:check": "tsgo"
	},
	"prettier": "@haltcase/style/prettier",
	"dependencies": {
		"cmd-ts": "^0.14.1",
		"tablemark": "^3.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/types": "^19.8.1",
		"@haltcase/style": "^7.3.1",
		"@types/node": "^20.19.11",
		"@typescript/native-preview": "7.0.0-dev.20250830.1",
		"eslint": "^9.34.0",
		"eslint-plugin-oxlint": "^1.14.0",
		"execa": "^9.6.0",
		"lefthook": "^1.12.3",
		"oxlint": "^1.14.0",
		"prettier": "^3.6.2",
		"semantic-release": "^24.2.7",
		"tsdown": "^0.14.2",
		"tsx": "catalog:",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=20"
		}
	}
}
